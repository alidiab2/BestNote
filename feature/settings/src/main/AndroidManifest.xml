<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Settings → Debug → Share debug log: hands the log file to the share sheet. -->
        <provider
            android:name="app.bestnote.feature.settings.data.DebugLogFileProvider"
            android:authorities="${applicationId}.debuglog"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/debug_log_paths" />
        </provider>
        <!-- AI-11: the button on the "signed in" page brings the app back and closes the Custom Tab. -->
        <activity
            android:name="app.bestnote.feature.settings.AiAccountReturnActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:host="ai-account" />
            </intent-filter>
        </activity>
    </application>
</manifest>
