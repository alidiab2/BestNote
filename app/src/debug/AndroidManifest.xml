<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only additions. The handwriting replay harness (QA-INK) never ships in release. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <provider
            android:name="app.bestnote.debug.replay.ReplayInstaller"
            android:authorities="${applicationId}.replay"
            android:exported="false" />
        <!-- REC-01: scores the handwriting recognizer on corpus files (adb broadcast). -->
        <receiver android:name="app.bestnote.debug.recognition.RecognitionEvalReceiver" android:exported="true">
            <intent-filter>
                <action android:name="app.bestnote.debug.RECOGNIZE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
