<?xml version="1.0" encoding="utf-8"?>
<!--
  Signing certificates of the Google Play services font provider (com.google.android.gms.fonts),
  one acceptable set per item. Extracted with `apksigner lineage \-\-print-certs-pem` from the
  PrebuiltGmsCore.apk of the google_apis emulator image (dev-keyed GMS, with its key-rotation lineage).
  TODO(DS-01 follow-up): add the production GMS certificate set (Google's standard font_certs.xml)
  so Play-certified devices verify the provider; until then they fall back to system fonts.
-->
<resources>
    <array name="com_google_android_gms_fonts_certs">
        <item>@array/com_google_android_gms_fonts_certs_1</item>
        <item>@array/com_google_android_gms_fonts_certs_2</item>
        <item>@array/com_google_android_gms_fonts_certs_3</item>
    </array>
    <!-- lineage 1 (original, "Android", android@android.com) -->
    <string-array name="com_google_android_gms_fonts_certs_1">
        <item></item>
    </string-array>
    <!-- lineage 2 (rotation-2020) -->
    <string-array name="com_google_android_gms_fonts_certs_2">
        <item></item>
    </string-array>
    <!-- lineage 3 (rotation-2024) -->
    <string-array name="com_google_android_gms_fonts_certs_3">
        <item></item>
    </string-array>
</resources>
